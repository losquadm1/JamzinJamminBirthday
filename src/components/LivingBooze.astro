---
const { title = "Night of the Living Booze" } = Astro.props;
---

<div class="living-booze">
<img class="web" src="img/cornerweb.png" alt="">
<img class="drink" src="img/skullbeer.png" alt="">
<img class="daria" src="img/daria.png" alt="">
  <br><h2>{title}</h2>
  <br><br>
  <p>November 13th 2026<br>7pm</p><br><br>
  <p>@ MOON POOL HOUSE<br>(New Paltz)</p><br><br>
  <p><a href="https://docs.google.com/forms/d/e/1FAIpQLSckm5farBWHZU3NjgGKeyhK5ZFOZcVzY6LNAy3osM3zqFJviw/viewform?usp=sharing&ouid=104045339381065558316">RSVP on this Google Form!</a></p><br><br>
  <p>Entry Fee: take a shot</p>
  <br><br>
</div>

<style>
  
a {
    color: var(--color-accent);
  }

a:visited {
    color: #009c00;
  }

  .web {
    position: absolute;
    top: 0;
    left: 0;
    width: 300px;
    margin-left: -15px;
    margin-top: -35px;
    display: block;
  }

  .drink {
    position: absolute;
    top: 400px;
    right: 0;
    width: 250px;
    margin-right: -25px;
    display: block;
  }

  .daria {
    position: absolute;
    top: -130px;
    right: 30;
    width: 275px;
    display: block;
    z-index: -2;
  }

  .living-booze {
    position: relative;
    border: 2px solid var(--color-accent);
    background-color: rgba(56, 4, 83, 0.91);
    padding: 1rem;
    margin-top: 1rem;
    width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .living-booze p,
  .living-booze h2 {
    text-align: center;
  }

  .living-booze h2 {
        color: var(--color-accent);
    font-family: var(--font-headings);
    font-size: 125px;
    letter-spacing: 7px;
    line-height: .75;
  }

  .living-booze p{
    font-size: 30px;
  }
</style>