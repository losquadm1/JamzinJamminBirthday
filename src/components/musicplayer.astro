---
const trackName = "People Are Still Having Sex";
const trackSrc = "/music/People Are Still Having Sex.mp3";
---

<div class="music-player">
  <div class="meta">
    <div class="meta-copy">
      <p class="label">Now playing</p>
      <p class="track-name">{trackName}</p>
    </div>
    <video class="jamzin-head" src="/img/jamzinhead.webm" muted loop playsinline aria-hidden="true"></video>
  </div>

  <div class="controls-row">
    <button type="button" class="play-toggle" aria-label="Play or pause">Play</button>
    <span id="current-time">0:00</span>
    <input type="range" class="seek-bar" min="0" max="100" value="0" step="0.1" aria-label="Audio position" />
    <span id="duration">0:00</span>
  </div>

  <div class="volume-row">
    <label for="volume-slider" class="volume-label">Volume</label>
    <input id="volume-slider" type="range" class="volume-slider" min="0" max="1" value="0.5" step="0.01" aria-label="Volume" />
  </div>

  <audio id="audio-player" src={trackSrc} preload="metadata"></audio>
</div>

<script is:inline>
  const audio = document.getElementById("audio-player");
  const playToggle = document.querySelector(".play-toggle");
  const jamzinHead = document.querySelector(".jamzin-head");
  const seekBar = document.querySelector(".seek-bar");
  const volumeSlider = document.getElementById("volume-slider");
  const currentTimeEl = document.getElementById("current-time");
  const durationEl = document.getElementById("duration");
  const volumeStorageKey = "jamzin-music-volume";
  const pausedStorageKey = "jamzin-music-paused";

  const savedVolume = Number(localStorage.getItem(volumeStorageKey));
  const savedPaused = localStorage.getItem(pausedStorageKey);
  const initialVolume = Number.isFinite(savedVolume) && savedVolume >= 0 && savedVolume <= 1
    ? savedVolume
    : Number(volumeSlider.value);
  const shouldPlay = savedPaused !== "true";

  audio.volume = initialVolume;
  volumeSlider.value = initialVolume;

  function formatTime(seconds) {
    if (!Number.isFinite(seconds)) return "0:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60)
      .toString()
      .padStart(2, "0");
    return `${mins}:${secs}`;
  }

  function syncVideoToAudio() {
    if (!Number.isFinite(audio.duration) || !Number.isFinite(jamzinHead.duration)) return;
    jamzinHead.currentTime = (audio.currentTime / audio.duration) * jamzinHead.duration;
  }

  playToggle.addEventListener("click", async () => {
    if (audio.paused) {
      try {
        await audio.play();
      } catch {
        playToggle.textContent = "Play";
      }
    } else {
      audio.pause();
    }
  });

  audio.addEventListener("loadedmetadata", () => {
    durationEl.textContent = formatTime(audio.duration);
    syncVideoToAudio();
  });

  jamzinHead.addEventListener("loadedmetadata", syncVideoToAudio);

  audio.addEventListener("timeupdate", () => {
    currentTimeEl.textContent = formatTime(audio.currentTime);
    seekBar.value = (audio.currentTime / audio.duration) * 100 || 0;
  });

  seekBar.addEventListener("input", (event) => {
    if (!audio.duration) return;
    const value = Number(event.target.value);
    audio.currentTime = (value / 100) * audio.duration;
    syncVideoToAudio();
  });

  volumeSlider.addEventListener("input", (event) => {
    audio.volume = Number(event.target.value);
    localStorage.setItem(volumeStorageKey, String(audio.volume));
  });

  audio.addEventListener("play", () => {
    playToggle.textContent = "Pause";
    jamzinHead.play().catch(() => {});
    localStorage.setItem(pausedStorageKey, "false");
  });

  audio.addEventListener("pause", () => {
    playToggle.textContent = "Play";
    jamzinHead.pause();
    localStorage.setItem(pausedStorageKey, "true");
  });

  if (shouldPlay) {
    audio.play().catch(() => {
      playToggle.textContent = "Play";
    });
  }
</script>

<style>
  .music-player {
    width: 100%;
    border: 2px solid var(--color-accent);
    background-color: rgba(0, 0, 0, 0.91);
    padding: 15px 14px 12px;
    box-sizing: border-box;
  }

  .meta {
    position: relative;
    min-height: 4rem;
    margin-bottom: -0.45rem;
  }

  .meta::after {
    content: "";
    position: absolute;
    top: .8rem;
    right: 1.7rem;
    width: 3rem;
    height: 2.1rem;
    border-radius: 50%;
    background: #00ff66;
    filter: blur(1.25rem);
    opacity: 1;
    pointer-events: none;
    z-index: 0;
  }

  .meta-copy {
    min-width: 0;
    padding-right: 4.5rem;
  }

  .label {
    margin: 0 0 0.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .track-name {
    margin: 0;
    font-weight: 700;
    color: var(--color-text);
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .jamzin-head {
    position: absolute;
    top: -30;
    right: 3;
    width: 6rem;
    height: 7rem;
    object-fit: cover;
    z-index: 1;
  }

  .controls-row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
  }

  .play-toggle {
    background: var(--color-accent);
    color: #120414;
    border: none;
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .seek-bar,
  .volume-slider {
    width: 100%;
    accent-color: var(--color-accent);
  }

  .volume-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .volume-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
    min-width: 3.5rem;
  }

  .music-player span {
    font-size: 0.8rem;
    color: var(--color-text);
    opacity: 0.85;
    min-width: 2.5rem;
    text-align: center;
  }
</style>