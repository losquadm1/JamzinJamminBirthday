---
import { ClientRouter } from "astro:transitions";

const targetDate = new Date("2026-11-13T19:00:00");
---

    <div class=status>
        <img src="img/user.png" alt=""> <p>Online Now!</p>
    </div>
<div class="countdown" aria-live="polite">
<div class="image">
    <h1>
        <img src="img/jazmin.jpg" alt="Jazmin Birthday Website">
    </h1>
    <p>welcome to my profile!</p>
</div>
<div class="day-box">
    <h2>21</h2>
    <span id="days">0</span>
    <p>days<br>away</p>
    <img class="frankie" src="img/frankie.png" alt="">
</div>
</div>

<script is:inline>
  const targetDate = new Date("2026-11-13T19:00:00");

  function updateCountdown() {
    const now = new Date();
    const diff = targetDate.getTime() - now.getTime();

    if (diff <= 0) {
      document.getElementById("days").textContent = "0";
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    document.getElementById("days").textContent = days;
  }

  updateCountdown();
  setInterval(updateCountdown, 1000 * 60 * 60 * 24);
</script>

<style>
.status {
    width: 375px;
    text-align: right;
    color: var(--color-accent);
    display: flex;
    justify-content: flex-end;
}
.status img {
    width: 20px;
    height: 20px;
    margin-top: 5px;
}
  .countdown {
    display: flex;
    flex-direction: row;
    text-align: center;
    color: var(--color-text);
    border: 2px solid var(--color-accent);
    background-color: rgba(0, 0, 0, 0.91);
    padding: 15px;
    width: 375px;
  }

  .h1 img {
    width: 200px;
  }
.frankie{
    width: 125px;
    padding-top: 10px;
}
  .day-box {
    font-family: var(--font-headings);
    color: var(--color-accent);
    padding-left: 15px;
    font-size: 40px;
    line-height: 50px;
  }
.image img {
    width: 250px;
}

.day-box h2 {
padding-bottom: 5px;
margin-top: -13px
}

.image {
    text-align: left;
}
</style>