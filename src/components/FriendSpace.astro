---
const response = await fetch('https://script.google.com/macros/s/AKfycbx4OdhxMCBTw-soO8uRsmAxp8LQSylM9NPyRn_d_UadBCczUYMZQAOHef3gM4k33H3HCg/exec');
const data = await response.json();
const photos = data.photos || [];
const number = photos.length;
---
<div class=rsvp>
    
<div class="title">
    <h3>paperdollspit's Friend Space</h3>
    
</div>

<div class="people">
    <p>paperdollspit has {number}<br>friends who RSVP'd</p>
<section class="gallery">
  {photos.map((photo) => (
    <img src={photo.url} alt=""/>
  ))}
</section>
</div>

</div>

<style>

p {
    text-align: center;
    font-family: var(--font-body);
    color: var(--color-body);
    font-size: 30px;
    letter-spacing: normal;
    font-weight: normal;
    padding-bottom: 1rem;
    line-height: 1.2;
}

h3 {
    text-align: center;
    font-family: var(--font-body);
    color: var(--color-body);
    font-size: 30px;
    letter-spacing: normal;
    font-weight: normal;}

    img {
        height: 150px;
        width: 150px;
        margin-bottom: 1rem;
        object-fit: cover;
    }

    .rsvp {
        border: 2px solid var(--color-accent);
        background-color: rgba(0, 0, 0, 0.8);
        padding: 0px;
        width: 375px;
        text-align: center;
        min-height: 765px;
    }

    .title {
        margin-bottom: 1rem;
        padding: 15px;
        border-bottom: 2px solid var(--color-accent);
    }

.people 
{padding-left: 25px;
        padding-right: 14px;
        }

    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
        justify-content: center;
    }
</style>