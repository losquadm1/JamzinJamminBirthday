---
---
<div class="rsvp" data-friend-space>
    
<div class="title">
    <h3>paperdollspit's Friend Space</h3>
    
</div>

<div class="people">
        <p>paperdollspit has <span data-photo-count>X</span><br>friends who RSVP'd</p>
<section class="gallery" data-photo-gallery>
</section>
<p data-photo-status aria-live="polite">Loading photos<span class="dots"></span></p>
</div>

</div>

<script>
    type Photo = { url: string; name?: string };

    const root = document.querySelector("[data-friend-space]");
    const count = root?.querySelector<HTMLElement>("[data-photo-count]");
    const gallery = root?.querySelector<HTMLElement>("[data-photo-gallery]");
    const status = root?.querySelector<HTMLElement>("[data-photo-status]");

    if (count && gallery && status) {
        const endpoint = "https://script.google.com/macros/s/AKfycbzTcNhO1fQNqBdQ6E-V4uCJ6TwqgrZXwlcT-KK0a_LyVW_WG0WqMmJOTgLudq_R2jsHNQ/exec";

        fetch(endpoint, { cache: "no-store" })
            .then((response) => {
                if (!response.ok) throw new Error(`Request failed: ${response.status}`);
                return response.json();
            })
            .then((data) => {
                const photos: Photo[] = Array.isArray(data.photos)
                    ? data.photos.filter((photo: Photo) => typeof photo.url === "string")
                    : [];

                count.textContent = String(photos.length);
                gallery.replaceChildren(...photos.map((photo) => {
                    const image = document.createElement("img");
                    image.src = photo.url;
                    image.alt = photo.name || "Friend photo";
                    image.loading = "lazy";
                    return image;
                }));
                status.hidden = photos.length > 0;
                status.textContent = photos.length ? "" : "No photos yet.";
            })
            .catch((error) => {
                console.error("Unable to load friend photos:", error);
                status.textContent = "Photos couldn't load. Please refresh.";
            });
    }
</script>

<style>

p {
    text-align: center;
    font-family: var(--font-body);
    color: var(--color-body);
    font-size: 30px;
    letter-spacing: normal;
    font-weight: normal;
    padding-bottom: 1rem;
    line-height: 1.2;
}

h3 {
    text-align: center;
    font-family: var(--font-body);
    color: var(--color-body);
    font-size: 30px;
    letter-spacing: normal;
    font-weight: normal;}

    /* Images are created at runtime, so scoped styles don't reach them. */
    .gallery :global(img) {
        width: 150px;
        height: 150px;
        aspect-ratio: 1 / 1;
        margin-bottom: 15px;
        object-fit: cover;
    }

    .rsvp {
        border: 2px solid var(--color-accent);
        background-color: rgba(0, 0, 0, 0.8);
        padding: 0px;
        width: 375px;
        text-align: center;
        min-height: 961px;
        padding-bottom: 20px
    }

    .title {
        margin-bottom: 1rem;
        padding: 15px;
        border-bottom: 2px solid var(--color-accent);
    }

.people 
{padding-left: 25px;
        padding-right: 14px;
        }

    .dots::after {
        content: ".";
        animation: dots 1.2s steps(1, end) infinite;
    }

    @keyframes dots {
        0% { content: "."; }
        33% { content: ".."; }
        66% { content: "..."; }
    }

    @media (prefers-reduced-motion: reduce) {
        .dots::after {
            content: "...";
            animation: none;
        }
    }

    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
        justify-content: center;
    }
</style>