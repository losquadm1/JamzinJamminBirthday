---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import LivingBooze from "@components/LivingBooze.astro";
import Countdown from "@components/Countdown.astro";
import MusicPlayer from "@components/musicplayer.astro";
import FriendSpace from "@components/FriendSpace.astro";
---

<Layout title="Living Booze">
  <meta name="viewport" content="width=device-width, initial-scale=0, maximum-scale=2, user-scalable=yes">
  <Container>
    <div class="body" id="top">
      
      <div class="top">
<div class="intro">
<Countdown />
</div>
<div class="music">
<br>
<div class="network">
  <p>paperdollspit is in your extended network</p>
</div>
<div class="musicplayer">
<MusicPlayer />
</div>
</div>
      </div>

      <div class="middle">
    <LivingBooze />
      </div>

      <div class="bottom">
<div class="spotify">
  <p>Add ur fave party songs to this playlist:<br>  
<a href="https://open.spotify.com/playlist/5TAlrKRw0RlH6Mv6ruqvbI?si=fnJMoFhFS6amV_Zbtx6Ccw&utm_source=copy-link&pi=vrym_v4oRleq0&pt=91359873a5a062e05762aab9eb372b64">  <img src="/img/spinningcd.gif" alt=""> </a>
<a href="https://open.spotify.com/playlist/5TAlrKRw0RlH6Mv6ruqvbI?si=fnJMoFhFS6amV_Zbtx6Ccw&utm_source=copy-link&pi=vrym_v4oRleq0&pt=91359873a5a062e05762aab9eb372b64">spotify link </a></p>
  </div>

<div class="rsvp">
<FriendSpace />
</div>
<div class="underbottom">
 <img class="nana" src="img/nana.png" alt="">
</div>
      </div>

<div class="return">
  <a class="back-to-top" href="#top">Back to top</a>
</div>
      
    </div>
  </Container>
</Layout>

<style>

a {
    color: var(--color-accent);
  }

a:visited {
    color: #009c00;
  }

a:hover,
a:focus-visible {
  color: #00bd00;
}


  body {
    background-image: url("/img/purplecheetah.jpg");
    x-overflow: hidden;
  }

  .body {
    position: relative;
    width: 800px;
  }

  @media (min-width: 850px) {
    .body {
      max-width: 800px;
    }
  }

  .body::after {
    content: "";
    position: absolute;
    top: 0;
    right: -50px;
    width: 125px;
    height: 100%;
    background-image: url("/img/blacklace.png");
    background-repeat: repeat-y;
    background-position: top right;
    background-size: 125px auto;
    pointer-events: none;
    z-index: -1;
  }

  @media (max-width: 850px) {
    .body::after {
      position: fixed;
      right: -20px
    }
  }
  .top {
    padding-top: 1rem;
    width: 800px;
    display: flex;
    flex-direction: row;
  }
  .intro, .music {width: 375px;}

  .music, .rsvp{
    margin-left: 50px;
  }
  
  .network {
    border: 2px solid var(--color-accent);
    background-color: rgba(0, 0, 0, 0.8);
    padding: 15px;
    width: 375px;
    text-align: center;
  }

    .spotify {
    border: 2px solid var(--color-accent);
    background-color: rgba(0, 0, 0, 0.8);
    padding: 15px;
    width: 375px;
    text-align: center;
    font-size: 30px;
    height: 485px;
    display: flex;
    flex-direction: column;
    align-content: center;
    flex-wrap: wrap;
  }

  .spotify a {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .spotify img:hover {
    filter: brightness(.5);
  }

    .bottom {
      padding-top: 1rem;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      width: 800px;
      padding-bottom: 1rem;
    }

    .underbottom {
      position: absolute;
      width: 800px;
      z-index: -1;
      margin-top: 260px;
    }

    .nana {
      object-fit: cover;
      position: static;
      bottom: 0;
      margin-left: -60px;
      z-index: -1;
      transform: scaleX(-1);
      width: 900px;
    }

  .musicplayer {
    margin-top: 1rem;
  }

  .return {
    padding-bottom: 1rem;
    text-align: center;
    width: 800px;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 850px) {
    .return {
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }

  .back-to-top {
    display: inline-block;
    background: var(--color-accent);
    color: #120414;
    border: none;
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-to-top:visited {
    color: #120414;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: #000000;
  }
</style>