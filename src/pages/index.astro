---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import LivingBooze from "@components/LivingBooze.astro";
import Countdown from "@components/Countdown.astro";
import MusicPlayer from "@components/musicplayer.astro";
import FriendSpace from "@components/FriendSpace.astro";
---

<Layout title="Astro Starter">
  <Container>
    <div class="body">
      
      <div class="top">
<div class="intro">
<Countdown />
</div>

<div class="music">
<br>
<div class="network">
  <p>paperdollspit is in your extended network</p>
</div>
<div class="musicplayer">
<MusicPlayer />
</div>
</div>
      </div>

      <div class="middle">
    <LivingBooze />
      </div>

      <div class="bottom">
<div class="spotify">
  <p>Add ur fave party songs to this playlist:<br>spotify link<br><br>:P</p>
</div>

<div class="rsvp">
<FriendSpace />
</div>
      </div>
    
    </div>
  </Container>
</Layout>

<style>
  .body {
    position: relative;
    padding-right: 36px;
  }

  .body::after {
    content: "";
    position: absolute;
    top: 0;
    right: -100;
    width: 125px;
    height: 100%;
    background-image: url("/img/blacklace.png");
    background-repeat: repeat-y;
    background-position: top right;
    background-size: 125px auto;
    pointer-events: none;
    z-index: -1;
  }

  .top {
    width: 800px;
    display: flex;
    flex-direction: row;
  }
  .intro, .music {width: 375px;}

  .music{
    margin-left: 50px;
  }
  
  .network {
    border: 2px solid var(--color-accent);
    background-color: rgba(0, 0, 0, 0.91);
    padding: 15px;
    width: 375px;
    text-align: center;
  }

    .spotify {
    border: 2px solid var(--color-accent);
    background-color: rgba(0, 0, 0, 0.91);
    padding: 15px;
    width: 375px;
    text-align: center;
    font-size: 30px;}

    .bottom {
      padding-top: 1rem;
    }


  .musicplayer {
    margin-top: 1rem;
  }
</style>