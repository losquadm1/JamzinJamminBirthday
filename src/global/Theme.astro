---
// we can import fonts here, after installing them via Fontsource
// see https://fontsource.org/docs/installation for instructions
---

<style>
  @font-face {
    font-family: "Deanna";
    src: url("/fonts/Deanna.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "W95FA";
    src: url("/fonts/W95F.otf") format("opentype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* We can use this style tag to set up colors, fonts, etc. */
  :root {
    --color-background: rgb(24, 0, 24);
    --color-text: rgb(240, 240, 240);
    --color-accent: #00FF00;
    --color-focus-ring: #00FF00;

    --font-body: "W95FA", sans-serif;
    --font-headings: "Deanna", sans-serif;

    font-size: 20px;

    /* These sizes are used by the Container component to set up the page container */
    --size-page-width: 800px;
    --size-page-padding: 1rem;
  }

  /* We can also apply these colors as a default */
  body {
     background-image: url("/img/purplecheetah.jpg");
    background-size: 400px;
    background-repeat: repeat;
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-accent);
    font-family: var(--font-headings);
    font-size: 100px;
    letter-spacing: 7px;
    line-height: .75;
  }

  /* default focus ring styles */
  *:focus-visible {
    outline: 3px solid var(--color-focus-ring);
  }
</style>
